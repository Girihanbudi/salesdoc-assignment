# Nothing here is required. Every variable has a default and the app runs with
# no .env at all — `npm run dev` and `docker compose up` both work bare.
# This file documents what exists and what each value does.
#
# Parsed and validated once at startup by apps/api/src/constant/env.ts, which
# throws on a bad value rather than falling back. Nothing else reads process.env.

# development | production | test
NODE_ENV=development

# Render assigns PORT. HOST must stay 0.0.0.0 in a container — a server bound
# to localhost is unreachable from outside it.
PORT=3000
HOST=0.0.0.0

# Absolute path to the built frontend. Unset means run API-only, which is how
# the tests and `npm run dev` work (Vite serves the UI in dev). In production
# the entrypoint fills this in automatically.
# WEB_ROOT=/app/apps/web/dist

# Simulated round-trip to the "external" CRM, in ms. This latency is why the
# per-call sync indicator renders `pending` before `synced` — an in-process
# call would settle in the same tick and the UI would never show the state the
# brief asks for. Setting both to 0 makes CRM writes instant.
CRM_LATENCY_MIN_MS=300
CRM_LATENCY_MAX_MS=800

# How long a mocked call rings before its outcome lands, in ms. Lower these to
# make a demo move faster; MIN must not exceed MAX or startup fails.
RING_MIN_MS=2000
RING_MAX_MS=6000
